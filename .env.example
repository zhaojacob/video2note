# Video Note System - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================================
# VISION APIs (for image analysis)
# ============================================================================

# GLM-4.6V API Key (for image analysis, math formulas, code understanding)
# Get from: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# Doubao API Key (Ark API, for Chinese document understanding)
# Get from: https://www.volcengine.com/docs/82379/1399008
ARK_API_KEY=your_ark_api_key_here

# ============================================================================
# TEXT LLM APIs (for text polishing, summaries, translations)
# ============================================================================

# ModelScope Token (Default) - Enables DeepSeek-V3.2 with thinking chain
# Get from: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_TOKEN=your_modelscope_token_here

# DeepSeek API Key (Fallback for text processing)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (Optional, for GPT-4o/GPT-4o-mini)
# Get from: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# PROVIDER-FIRST LLM ARCHITECTURE (NEW - Recommended)
# ============================================================================

# Enable unified LLM manager (recommended)
# Set to "true" to use the new provider-first architecture
# Options: true, false (default: false)
USE_UNIFIED_LLM=true

# Default providers by task type
# These determine which provider to use for each type of task
DEFAULT_TEXT_PROVIDER=zhipu
DEFAULT_VISION_PROVIDER=zhipu
DEFAULT_THINKING_PROVIDER=deepseek

# Default models (optional - will use provider's default if not specified)
# Note: DeepSeek models are "deepseek-chat" (non-thinking) and "deepseek-reasoner" (thinking)
DEFAULT_TEXT_MODEL=glm-4-flash
DEFAULT_VISION_MODEL=glm-4.6v

# ============================================================================
# CUSTOM PROVIDERS (Up to 10 custom providers supported)
# ============================================================================

# Custom Provider 1: Example - OpenAI-compatible proxy
# Uncomment and fill in your details
# CUSTOM_PROVIDER_1_NAME=MyProxy
# CUSTOM_PROVIDER_1_BASE_URL=https://my-proxy.com/v1
# CUSTOM_PROVIDER_1_API_KEY=MY_PROXY_KEY
# CUSTOM_PROVIDER_1_MODELS=gpt-4,gpt-4o

# Custom Provider 2: Example - Local LLM (e.g., Ollama)
# Uncomment and fill in your details
# CUSTOM_PROVIDER_2_NAME=LocalOllama
# CUSTOM_PROVIDER_2_BASE_URL=http://localhost:11434/v1
# CUSTOM_PROVIDER_2_API_KEY=ollama
# CUSTOM_PROVIDER_2_MODELS=llama3,mistral

# You can add up to CUSTOM_PROVIDER_10_*
# ============================================================================

# Text LLM provider selection (only used if USE_UNIFIED_LLM=false)
# Options: modelscope (default), deepseek
TEXT_LLM_PROVIDER=modelscope

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# HTTP Proxy (uncomment if needed)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
