# ============================================================================
# Video Note System - 环境变量配置示例
# ============================================================================
# 复制此文件为 .env 并填入你的 API Keys
# 注意: .env 文件不应提交到版本控制系统
# ============================================================================

# ----------------------------------------------------------------------------
# LLM API Keys (必需 - 至少配置一个)
# ----------------------------------------------------------------------------

# DeepSeek API Key (文本任务、思考任务)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 字节跳动豆包 API Key (视觉任务)
# 获取地址: https://console.volcengine.com/
ARK_API_KEY=your_ark_api_key_here

# ----------------------------------------------------------------------------
# 可选配置
# ----------------------------------------------------------------------------

# 是否启用统一 LLM 管理器 (默认: true)
USE_UNIFIED_LLM=true

# 默认文本任务 Provider (默认: deepseek)
DEFAULT_TEXT_PROVIDER=deepseek

# 默认文本任务模型 (默认: deepseek-chat)
DEFAULT_TEXT_MODEL=deepseek-chat

# 默认视觉任务 Provider (默认: bytedance)
DEFAULT_VISION_PROVIDER=bytedance

# 默认视觉任务模型 (默认: doubao-seed-1-6-vision-250815)
DEFAULT_VISION_MODEL=doubao-seed-1-6-vision-250815

# 默认思考任务 Provider (默认: deepseek)
DEFAULT_THINKING_PROVIDER=deepseek

# ----------------------------------------------------------------------------
# 其他配置
# ----------------------------------------------------------------------------

# 文本 LLM Provider (legacy, 默认: deepseek)
TEXT_LLM_PROVIDER=deepseek
