# Video Note System - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================================
# VISION APIs (for image analysis)
# ============================================================================

# GLM-4.6V API Key (for image analysis, math formulas, code understanding)
# Get from: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# Doubao API Key (Ark API, for Chinese document understanding)
# Get from: https://www.volcengine.com/docs/82379/1399008
ARK_API_KEY=your_ark_api_key_here

# ============================================================================
# TEXT LLM APIs (for text polishing, summaries, translations)
# ============================================================================

# ModelScope Token (Default) - Enables DeepSeek-V3.2 with thinking chain
# Get from: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_TOKEN=your_modelscope_token_here

# DeepSeek API Key (Fallback for text processing)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (Optional, for GPT-4o/GPT-4o-mini)
# Get from: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# UNIFIED LLM ARCHITECTURE (NEW - Recommended)
# ============================================================================

# Enable unified LLM manager (recommended)
# Set to "true" to use the new unified architecture
# Options: true, false (default: false)
USE_UNIFIED_LLM=true

# Default model for text tasks
# Options: glm-4-flash, deepseek-chat, deepseek-v3, gpt-4o-mini, gpt-4o
DEFAULT_TEXT_MODEL=glm-4-flash

# Default model for vision/image tasks
# Options: glm-4.6v, doubao-vision, gpt-4o, gpt-4o-mini
DEFAULT_VISION_MODEL=glm-4.6v

# ============================================================================
# LEGACY CONFIGURATION (Backward Compatible)
# ============================================================================

# Text LLM provider selection (only used if USE_UNIFIED_LLM=false)
# Options: modelscope (default), deepseek
TEXT_LLM_PROVIDER=modelscope

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# HTTP Proxy (uncomment if needed)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
