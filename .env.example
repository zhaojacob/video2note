# Video Note System - Environment Variables
# Copy this file to .env and fill in your API keys

# GLM-4.6V API Key (for image analysis)
# Get from: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# Doubao API Key (Ark API, for image analysis)
# Get from: https://www.volcengine.com/docs/82379/1399008
ARK_API_KEY=your_ark_api_key_here

# DeepSeek API Key (for summary generation)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: HTTP Proxy (uncomment if needed)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
